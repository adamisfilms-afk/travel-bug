# --- Flights -----------------------------------------------------------------
# Google Flights results via SearchApi.io (server-only). Used automatically when set.
SEARCHAPI_API_KEY=
SEARCHAPI_CURRENCY=USD
SEARCHAPI_COUNTRY=uk
# Set to 1 to log the shape of SearchApi responses in the server terminal.
SEARCHAPI_DEBUG=

# Skyscanner partner API (optional; only if you're accepted as a partner).
SKYSCANNER_API_KEY=
SKYSCANNER_MARKET=UK
SKYSCANNER_LOCALE=en-GB
SKYSCANNER_CURRENCY=USD

# Force a provider: searchapi | skyscanner | mock. Default: whichever key is set, else mock.
FLIGHT_PROVIDER=

# --- Storage -------------------------------------------------------------------
# Optional. Without these, trips are stored in the browser (localStorage).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
