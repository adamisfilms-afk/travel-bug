# --- Flights -----------------------------------------------------------------
# SearchApi.io key (server-only). With it, flights come from Skyscanner via SearchApi
# (direct seller booking links), falling back to Google Flights if that fails.
SEARCHAPI_API_KEY=
SEARCHAPI_COUNTRY=uk
# Set to 1 to log the shape of SearchApi responses in the server terminal.
SEARCHAPI_DEBUG=
# Planner price checks reuse SearchApi responses up to this many minutes old (default 360 = 6 hours).
# Lower = fresher prices, more credits. "Refresh prices" always uses results under 10 minutes old.
PRICE_CHECK_TTL_MINUTES=

# Skyscanner partner API (optional; only if you're accepted as a partner).
SKYSCANNER_API_KEY=
SKYSCANNER_MARKET=UK
SKYSCANNER_LOCALE=en-GB
SKYSCANNER_CURRENCY=USD

# Force a provider: skyscanner_searchapi | google_flights | skyscanner (official API) | mock.
# Default: skyscanner_searchapi if SEARCHAPI_API_KEY is set, else skyscanner, else mock.
FLIGHT_PROVIDER=

# Affiliate tracking for Skyscanner booking links. Use your Impact deep-link format with
# {url} where the Skyscanner URL goes, e.g. https://skyscanner.pxf.io/c/XXXX/YYYY/ZZZZ?u={url}
AFFILIATE_LINK_TEMPLATE=

# Hotels also use SEARCHAPI_API_KEY (Skyscanner hotels). Set to "mock" to keep sample hotels.
HOTEL_PROVIDER=

# --- Maps ----------------------------------------------------------------------
# Mapbox public token (starts with pk.). Without it, maps use CARTO's free tiles (dev only).
NEXT_PUBLIC_MAPBOX_TOKEN=
# Optional Mapbox Studio style ("username/style-id"); default mapbox/light-v11.
NEXT_PUBLIC_MAPBOX_STYLE=

# --- Google (food guides) ------------------------------------------------------
# Places API (New) key, server-only: main photo of each restaurant's Google Maps listing.
# Without it, food cards show coloured placeholders.
GOOGLE_MAPS_API_KEY=

# --- Storage -------------------------------------------------------------------
# Optional. Without these, trips are stored in the browser (localStorage).
# Accounts and storage. With these set, people sign up / log in and their trips are saved to
# Supabase; without them the app is a single local user with trips in the browser.
# URL: Project Settings → Data API (just https://xxxx.supabase.co — no /rest/v1/).
# Key: Project Settings → API Keys → Publishable key (sb_publishable_…) or the legacy anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_… or legacy service_role) — SERVER ONLY, never NEXT_PUBLIC_.
# Needed for admin edits, photo uploads and shared itinerary links.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: live searches / price checks allowed per user per 10 minutes (default 60).
PAID_REQUESTS_PER_10_MIN=

# --- Email ---------------------------------------------------------------------
# Trip invites by email. Server only. Use ONE of:
#
# A) Gmail (for now): turn on 2-Step Verification on the Google account, then create an
#    app password (myaccount.google.com/apppasswords) and paste it here — not your normal password.
#    Gmail sends from your own address only, up to about 500 emails a day.
SMTP_USER=
SMTP_PASS=
# Optional (defaults shown): SMTP_HOST=smtp.gmail.com  SMTP_PORT=465
#
# B) Resend (once you own a domain): verify the domain in Resend, then set the key.
RESEND_API_KEY=
#
# The sender, e.g. "wheretonext <you@gmail.com>" (Gmail) or "wheretonext <hello@yourdomain.com>" (Resend).
EMAIL_FROM=

# Trip assistant (Claude). Server-only — never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Optional: messages each person can send in 24 hours (default 10; admins aren't limited)
# ASSISTANT_MESSAGES_PER_DAY=10
# Optional: model (default claude-sonnet-5-5)
# ASSISTANT_MODEL=claude-sonnet-5-5
