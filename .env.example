# Server-only. Without it, /api/flights/* returns realistic mock data.
SKYSCANNER_API_KEY=
# Market/locale/currency sent to Skyscanner
SKYSCANNER_MARKET=UK
SKYSCANNER_LOCALE=en-GB
SKYSCANNER_CURRENCY=USD

# Optional. Without these, trips are stored in the browser (localStorage).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
